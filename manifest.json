{
  "manifest_version": 3,
  "name": "Roblox Audio Downloader",
  "version": "1.2",
  "description": "Download audio directly from Roblox asset pages with one click.",
  "host_permissions": [
    "https://create.roblox.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://create.roblox.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
